#!/usr/bin/env expect
# Deterministic PTY checks; all installer files live in a temporary HOME/TMPDIR.
set timeout 30
log_user [expr {[info exists env(JUS_PTY_VERBOSE)] ? 1 : 0}]
set driver {
(require '[babashka.classpath :as cp])
(cp/add-classpath "scripts:test")
(require '[jus.tui.core :as core] '[jus.tui.repls :as repls]
         '[jus.tui.repl-installer :as installer]
         '[jus.tui.repl-installer-test :as fixture]
         '[charm.program :as program] '[clojure.java.io :as io]
         '[babashka.fs :as fs])
(let [{:keys [env root]} (fixture/fixture!)
      start installer/start!
      scenario (System/getenv "JUS_REPL_TEST_SCENARIO")
      bootstrap (case scenario
                  "failure" "echo INSTALL_FAILED >&2; return 7\n"
                  "cancel" "echo INSTALL_WAITING; sleep 120\n"
                  (str fixture/successful-bootstrap
                       "printf '#!/bin/bash\nprintf \"NATIVE_READY\\\\n\"\nread -r answer\nprintf \"RESULT:%%s\\\\n\" \"$answer\"\n' > \"$prefix/bin/glj\"\n"))]
  (println "FIXTURE_ROOT" root)
  (flush)
  (try
    (spit (io/file (:home env) "bootstrap") bootstrap)
    (let [state (with-redefs [repls/discover (constantly nil)
                             installer/start! #(start (assoc % :locations env))]
                  (program/run {:init (fn [] [(assoc (core/main-menu-state {}) :step :repl-menu :menu-idx 6) nil])
                                :update core/update-fn :view core/view :alt-screen true}))]
      (if (= :repl (:action state))
        ((deref (ns-resolve 'jus.tui.core 'run-repl!)) (:repl-id state) (:repl-executable state))
        (do (println "EXIT_CODE" (:exit-code state)) (flush))))
    (finally (fs/delete-tree root))))
}

proc expect_text {pattern description} {
    expect {
        -re $pattern {}
        timeout {error "Timed out: $description"}
        eof {error "Unexpected EOF: $description"}
    }
}

foreach scenario {temporary persistent failure cancel} {
    set env(JUS_REPL_TEST_SCENARIO) $scenario
    spawn -noecho bb -e $driver
    stty rows 24 columns 120 < $spawn_out(slave,name)
    expect -re {FIXTURE_ROOT ([^\r\n]+)}
    set fixture_root $expect_out(1,string)
    expect_text {Select REPL type} "dialect menu"
    send -- "\r"
    expect_text {installation not found} "installation menu"
    if {$scenario eq "persistent"} {send -- "\033\[B"}
    send -- "\r"
    if {$scenario eq "failure"} {
        expect_text {INSTALL_FAILED} "failure diagnostics"
        send -- "\r"
        expect_text {Select REPL type} "return to dialect menu"
        send -- "\003"
        expect_text {EXIT_CODE 130} "Ctrl-C exit"
    } elseif {$scenario eq "cancel"} {
        expect_text {Installing Glojure} "installation spinner"
        send -- "\033"
        expect_text {Select REPL type} "Escape cancellation"
        send -- "\003"
        expect_text {EXIT_CODE 130} "Ctrl-C exit"
    } else {
        expect_text {NATIVE_READY} "automatic native handoff"
        send -- "hello\r"
        expect_text {RESULT:hello} "interactive stdin"
    }
    expect eof
    set status [wait]
    file delete -force -- $fixture_root
    if {[lindex $status 3] != 0} {error "$scenario failed: $status"}
    puts "PASS $scenario"
}
